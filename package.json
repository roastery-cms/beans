{
	"name": "@roastery/beans",
	"description": "Blueprint-driven DDD building blocks for TypeScript: declare the model once as a plain object and derive validated construction, the TypeBox schema, serialization, typed accessors, domain events, repository ports and coherent fixtures — across a domain layer (Entity, ValueObject, DomainEvent) and an application layer (Command, registries).",
	"version": "0.4.0",
	"type": "module",
	"author": {
		"name": "Alan Reis",
		"email": "alanreisanjo@gmail.com",
		"url": "https://github.com/Hoyasumii"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/roastery-cms/beans"
	},
	"license": "MIT",
	"keywords": [
		"@roastery",
		"@roastery/beans",
		"aggregate",
		"aggregate-root",
		"beans",
		"blueprint",
		"clean-architecture",
		"command",
		"ddd",
		"domain-driven-design",
		"domain-events",
		"entity",
		"event-driven",
		"fixtures",
		"framework",
		"hexagonal-architecture",
		"hoyasumii",
		"in-memory-repository",
		"repository",
		"roastery",
		"roastery-beans",
		"schema",
		"test-doubles",
		"typebox",
		"typescript",
		"use-case",
		"validation",
		"value-object"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*/index.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./*": {
			"types": "./dist/*/index.d.ts",
			"import": "./dist/*/index.js",
			"require": "./dist/*/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "biome check --fix && knip && tsup 'src/**/index.ts' --format cjs,esm --dts --tsconfig tsconfig.build.json --clean",
		"test:unit": "bun test --env-file=.env.testing",
		"test:coverage": "bun test --env-file=.env.testing --coverage",
		"example": "bun run examples/user-flow.ts",
		"setup": "bun run build && bun link",
		"prepare": "husky || true",
		"knip": "knip"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.4.3",
		"@commitlint/config-conventional": "^20.4.3",
		"husky": "^9.1.7",
		"knip": "^5.85.0"
	},
	"peerDependencies": {
		"typescript": "7.0.2",
		"@types/bun": "latest",
		"tsup": "^8.5.1"
	},
	"dependencies": {
		"@roastery/terroir": "^0.2.1",
		"slugify": "^1.6.6"
	}
}
